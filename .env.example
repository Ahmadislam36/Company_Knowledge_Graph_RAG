# Groq API key - https://console.groq.com/keys se FREE milti hai
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-120b

# Embedding model - local hai (fastembed), koi API key nahi chahiye
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Neo4j - free Aura instance: https://neo4j.com/cloud/aura
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
